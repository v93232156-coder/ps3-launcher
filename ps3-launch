#include <stdio.h>
#include <psl1ght/lv2.h> // Системные вызовы
#include <io/pad.h>      // Джойстик
#include <tiny3d.h>      // Графика

// Функция для активации чтения болванок (упрощенно)
void enable_disks() {
    // Syscall 8 используется в CFW для патчинга функций привода
    // Команда 0x7032 обычно отвечает за монтирование/патч диска
    lv2syscall4(8, 0x7032, 0x1, 0, 0); 
}

int main() {
    tiny3d_Init(1024*1024);
    padInit(7);

    while(1) {
        tiny3d_Clear(0xFF000000, TINY3D_CLEAR_ALL); // Черный фон
        tiny3d_ProjectGui();
        
        draw_text(50, 50, "PS3 DISC ACTIVATOR");
        draw_text(50, 150, "Нажми X чтобы запустить болванку");

        padData pad;
        padGetPortData(0, &pad);
        
        if(pad.BTN_CROSS) {
            enable_disks(); // Вызываем наш патч
            draw_text(50, 200, "ГОТОВО! МОЖНО ЗАПУСКАТЬ");
            // Тут обычно идет команда выхода в XMB, чтобы увидеть диск
        }

        tiny3d_Flip();
    }
    return 0;
}

